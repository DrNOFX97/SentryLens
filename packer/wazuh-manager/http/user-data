#cloud-config
autoinstall:
  version: 1
  locale: en_US
  keyboard:
    layout: us
    variant: ''
  network:
    network:
      version: 2
      ethernets:
        eth0:
          dhcp4: true
  apt:
    geoip: true
    preserve_sources_list: false
    primary:
      - arches: [amd64]
        uri: http://archive.ubuntu.com/ubuntu
    security:
      - arches: [amd64]
        uri: http://security.ubuntu.com/ubuntu
  storage:
    layout:
      name: lvm
  identity:
    hostname: sentrylens-wazuh
    username: sentrylens
    password: "$6$rounds=4096$sentrylens$W8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8"
    realname: "SentryLens User"
  ssh:
    allow-pw: true
    install-server: true
    authorized-keys: []
  packages:
    - openssh-server
    - curl
    - wget
    - gnupg
    - lsb-release
    - ca-certificates
    - python3
    - python3-pip
    - virtualbox-guest-utils
    - virtualbox-guest-dkms
  late-commands:
    - echo 'sentrylens ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/sentrylens
    - chmod 440 /target/etc/sudoers.d/sentrylens
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- systemctl enable vboxadd-service
    - curtin in-target --target=/target -- systemctl enable vboxadd