#cloud-config
autoinstall:
  version: 1
  locale: en_US
  keyboard:
    layout: us
    variant: ''
  network:
    network:
      version: 2
      ethernets:
        eth0:
          dhcp4: true
  apt:
    geoip: true
    preserve_sources_list: false
  storage:
    layout:
      name: lvm
  identity:
    hostname: sentrylens-kali
    username: kali
    password: "$6$rounds=4096$kali$W8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8Z8"
    realname: "Kali User"
  ssh:
    allow-pw: true
    install-server: true
    authorized-keys: []
  packages:
    - openssh-server
    - curl
    - wget
    - gnupg
    - lsb-release
    - ca-certificates
    - python3
    - python3-pip
    - python3-venv
    - virtualbox-guest-utils
    - virtualbox-guest-dkms
    - linux-headers-$(uname -r)
    - nmap
    - hydra
    - john
    - hashcat
    - sqlmap
    - metasploit-framework
    - crackmapexec
    - impacket-scripts
    - bloodhound
    - neo4j
    - gobuster
    - dirb
    - nikto
    - wpscan
    - enum4linux
    - smbclient
    - rpcclient
    - ldap-utils
    - kerberos-user
    - proxychains4
    - torsocks
    - sshpass
  late-commands:
    - echo 'kali ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/kali
    - chmod 440 /target/etc/sudoers.d/kali
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- systemctl enable vboxadd-service
    - curtin in-target --target=/target -- systemctl enable vboxadd