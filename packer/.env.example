# Copiar para packer/.env (gitignored). build-all.ps1 lê este ficheiro e
# passa cada password ao packer por -var, nunca por um default no .pkr.hcl.
# Passwords diferentes por VM, de preferência fortes e só para o laboratório
# (as VMs nunca saem da rede do host; ver packer/README.md).
SENTRYLENS_WAZUH_SSH_PASSWORD=escolhe-uma-password-forte-aqui
SENTRYLENS_KALI_SSH_PASSWORD=escolhe-outra-password-forte-aqui
