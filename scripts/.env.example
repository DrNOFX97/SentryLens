# Wazuh Manager API (porta 55000)
WAZUH_MANAGER_URL=https://<IP_DA_VM>:55000
WAZUH_MANAGER_USER=wazuh-wui
WAZUH_MANAGER_PASSWORD=

# Wazuh Indexer API (porta 9200)
WAZUH_INDEXER_URL=https://<IP_DA_VM>:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=

# false (default) = aceita o certificado autoassinado do lab, sem validar a
# cadeia de confiança. Muda para true só se o Manager/Indexer tiver um
# certificado válido (CA confiável) — caso contrário os pedidos vão falhar.
WAZUH_VERIFY_SSL=false

# Diretório com isolation_forest.pkl + scaler.pkl (ver train_anomaly_model.py).
# Default: <pasta de scripts>/models
ML_MODEL_DIR=

# Obrigatória — sem ela, TODOS os pedidos a /api/* são recusados com 401
# (fail-closed, não há valor por omissão). Gera um valor aleatório forte, ex.:
#   PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Bash/OpenSSL: openssl rand -hex 32
# O frontend tem de enviar o mesmo valor no header X-API-Key em cada pedido.
SENTRYLENS_API_KEY=
